# ═══ SISTEMA OPERATIVO Y CACHÉ ═══
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ═══ CONFIGURACIÓN DE EDITORES / IDEs ═══
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# ═══ PAQUETES / DEPENDENCIAS Y LOGS ═══
node_modules/
/dist/
/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ═══ PYTHON (Para convert_assets.py y entornos virtuales) ═══
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
